generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum HouseholdRole {
  OWNER
  MEMBER
}

enum ExpenseType {
  INCOME
  EXPENSE
}

enum CalendarEventCategory {
  CARE
  GUESTS
  HOME
  SCHOOL
}

model User {
  id                String            @id @default(cuid())
  name              String?
  email             String?           @unique
  emailVerified     DateTime?
  image             String?
  accounts          Account[]
  sessions          Session[]
  memberships       HouseholdMember[]
  calendarEvents    CalendarEvent[]
  todoLists         TodoList[]
  shoppingLists     ShoppingList[]
  notes             Note[]
  expenseCategories ExpenseCategory[]
  expenses          Expense[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

model Household {
  id                String            @id @default(cuid())
  name              String
  members           HouseholdMember[]
  calendarEvents    CalendarEvent[]
  todoLists         TodoList[]
  shoppingLists     ShoppingList[]
  notes             Note[]
  expenseCategories ExpenseCategory[]
  expenses          Expense[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

model HouseholdMember {
  id          String        @id @default(cuid())
  role        HouseholdRole @default(MEMBER)
  userId      String
  householdId String
  createdAt   DateTime      @default(now())
  household   Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  expenses Expense[]

  @@unique([userId, householdId])
  @@index([householdId])
}

model CalendarEvent {
  id              String                @id @default(cuid())
  dateKey         String                @db.VarChar(10)
  name            String                @db.VarChar(200)
  category        CalendarEventCategory
  allDay          Boolean               @default(true)
  time            String?               @db.VarChar(5)
  people          String[]              @default([])
  householdId     String?
  createdByUserId String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  household       Household?            @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdBy       User?                 @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([dateKey])
  @@index([householdId, dateKey])
  @@index([createdByUserId, dateKey])
}

model Note {
  id              String     @id @default(cuid())
  title           String     @db.VarChar(200)
  body            String     @db.Text
  householdId     String?
  createdByUserId String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  household       Household? @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdBy       User?      @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([householdId])
  @@index([createdByUserId])
}

model TodoList {
  id              String     @id @default(cuid())
  name            String     @db.VarChar(120)
  householdId     String?
  createdByUserId String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  items           TodoItem[]
  household       Household? @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdBy       User?      @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([householdId])
  @@index([createdByUserId])
}

model TodoItem {
  id         String   @id @default(cuid())
  text       String   @db.VarChar(500)
  done       Boolean  @default(false)
  todoListId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  list       TodoList @relation(fields: [todoListId], references: [id], onDelete: Cascade)

  @@index([todoListId])
}

model ShoppingList {
  id              String         @id @default(cuid())
  name            String         @db.VarChar(120)
  householdId     String?
  createdByUserId String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  items           ShoppingItem[]
  household       Household?     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdBy       User?          @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([householdId])
  @@index([createdByUserId])
}

model ShoppingItem {
  id             String       @id @default(cuid())
  text           String       @db.VarChar(500)
  done           Boolean      @default(false)
  shoppingListId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  list           ShoppingList @relation(fields: [shoppingListId], references: [id], onDelete: Cascade)

  @@index([shoppingListId])
}

model ExpenseCategory {
  id              String     @id @default(cuid())
  name            String     @db.VarChar(60)
  color           String     @default("#6e9274") @db.VarChar(7)
  householdId     String?
  createdByUserId String?
  createdAt       DateTime   @default(now())
  expenses        Expense[]
  household       Household? @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdBy       User?      @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([householdId])
  @@index([createdByUserId])
}

model Expense {
  id                String           @id @default(cuid())
  name              String           @db.VarChar(200)
  amount            Decimal          @db.Decimal(12, 2)
  type              ExpenseType
  date              DateTime
  notes             String?          @db.VarChar(1000)
  memberName        String?          @db.VarChar(120)
  householdMemberId String?
  categoryId        String?
  householdId       String?
  createdByUserId   String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  householdMember   HouseholdMember? @relation(fields: [householdMemberId], references: [id], onDelete: SetNull)
  category          ExpenseCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  household         Household?       @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdBy         User?            @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([householdId])
  @@index([householdId, date])
  @@index([categoryId])
  @@index([createdByUserId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
