generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum HouseholdRole {
  OWNER
  MEMBER
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REVOKED
}

enum ExpenseType {
  INCOME
  EXPENSE
}

enum CalendarEventCategory {
  CARE
  GUESTS
  HOME
  SCHOOL
}

model User {
  id                String            @id
  name              String?
  email             String?           @unique
  image             String?
  deletedAt         DateTime?
  memberships       HouseholdMember[]
  invitesSent       HouseholdInvite[] @relation("InvitesSent")
  calendarEvents    CalendarEvent[]
  todoLists         TodoList[]
  shoppingLists     ShoppingList[]
  notes             Note[]
  expenseCategories ExpenseCategory[]
  expenses          Expense[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

model Household {
  id                String            @id @default(cuid())
  name              String
  deletedAt         DateTime?
  members           HouseholdMember[]
  invites           HouseholdInvite[]
  calendarEvents    CalendarEvent[]
  todoLists         TodoList[]
  shoppingLists     ShoppingList[]
  notes             Note[]
  expenseCategories ExpenseCategory[]
  expenses          Expense[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

model HouseholdMember {
  id          String        @id @default(cuid())
  role        HouseholdRole @default(MEMBER)
  color       String        @default("sage") @db.VarChar(24)
  userId      String
  householdId String
  createdAt   DateTime      @default(now())
  household   Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  expenses Expense[]

  @@unique([userId])
  @@unique([userId, householdId])
  @@index([householdId])
}

model CalendarEvent {
  id              String                @id @default(cuid())
  dateKey         String                @db.VarChar(10)
  name            String                @db.VarChar(200)
  category        CalendarEventCategory
  allDay          Boolean               @default(true)
  time            String?               @db.VarChar(5)
  people          String[]              @default([])
  householdId     String?
  createdByUserId String?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  household       Household?            @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdBy       User?                 @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([dateKey])
  @@index([householdId, dateKey])
  @@index([createdByUserId, dateKey])
}

model Note {
  id              String     @id @default(cuid())
  title           String     @db.VarChar(200)
  body            String     @db.Text
  householdId     String?
  createdByUserId String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  household       Household? @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdBy       User?      @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([householdId])
  @@index([createdByUserId])
}

model TodoList {
  id              String     @id @default(cuid())
  name            String     @db.VarChar(120)
  householdId     String?
  createdByUserId String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  items           TodoItem[]
  household       Household? @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdBy       User?      @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([householdId])
  @@index([createdByUserId])
}

model TodoItem {
  id         String   @id @default(cuid())
  text       String   @db.VarChar(500)
  done       Boolean  @default(false)
  todoListId String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  list       TodoList @relation(fields: [todoListId], references: [id], onDelete: Cascade)

  @@index([todoListId])
}

model ShoppingList {
  id              String         @id @default(cuid())
  name            String         @db.VarChar(120)
  householdId     String?
  createdByUserId String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  items           ShoppingItem[]
  household       Household?     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdBy       User?          @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([householdId])
  @@index([createdByUserId])
}

model ShoppingItem {
  id             String       @id @default(cuid())
  text           String       @db.VarChar(500)
  done           Boolean      @default(false)
  shoppingListId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  list           ShoppingList @relation(fields: [shoppingListId], references: [id], onDelete: Cascade)

  @@index([shoppingListId])
}

model ExpenseCategory {
  id              String     @id @default(cuid())
  name            String     @db.VarChar(60)
  color           String     @default("#6e9274") @db.VarChar(7)
  householdId     String?
  createdByUserId String?
  createdAt       DateTime   @default(now())
  expenses        Expense[]
  household       Household? @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdBy       User?      @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([householdId])
  @@index([createdByUserId])
}

model Expense {
  id                String           @id @default(cuid())
  name              String           @db.VarChar(200)
  amount            Decimal          @db.Decimal(12, 2)
  type              ExpenseType
  date              DateTime
  notes             String?          @db.VarChar(1000)
  memberName        String?          @db.VarChar(120)
  householdMemberId String?
  categoryId        String?
  householdId       String?
  createdByUserId   String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  householdMember   HouseholdMember? @relation(fields: [householdMemberId], references: [id], onDelete: SetNull)
  category          ExpenseCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  household         Household?       @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdBy         User?            @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([householdId])
  @@index([householdId, date])
  @@index([categoryId])
  @@index([createdByUserId])
}

model HouseholdInvite {
  id          String       @id @default(cuid())
  token       String       @unique
  email       String
  householdId String
  invitedById String
  status      InviteStatus @default(PENDING)
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime     @default(now())
  household   Household    @relation(fields: [householdId], references: [id], onDelete: Cascade)
  invitedBy   User         @relation("InvitesSent", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([householdId])
  @@index([email])
}
