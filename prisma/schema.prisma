generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum HouseholdRole {
  OWNER
  MEMBER
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REVOKED
}

enum ExpenseType {
  INCOME
  EXPENSE
}

enum CalendarEventCategory {
  CARE
  GUESTS
  HOME
  SCHOOL
}

enum ChoreIntervalUnit {
  DAYS
  WEEKS
  MONTHS
}

enum ChoreAssignmentType {
  UNASSIGNED
  FIXED
  ROTATING
}

enum ChoreRecurrenceType {
  DAILY
  WEEKLY
  MONTHLY
  CUSTOM
}

model User {
  id                         String            @id
  name                       String?
  email                      String?           @unique
  image                      String?
  deletedAt                  DateTime?
  developmentAccessGrantedAt DateTime?
  memberships                HouseholdMember[] @relation("HouseholdMemberAccount")
  createdHouseholdMembers    HouseholdMember[] @relation("HouseholdMemberCreatedBy")
  invitesSent                HouseholdInvite[] @relation("InvitesSent")
  calendarEvents             CalendarEvent[]
  todoLists                  TodoList[]
  shoppingLists              ShoppingList[]
  notes                      Note[]
  expenseCategories          ExpenseCategory[]
  choreCategories            ChoreCategory[]
  expenses                   Expense[]
  choresCreated              Chore[]
  choreCompletions           ChoreCompletion[]
  createdAt                  DateTime          @default(now())
  updatedAt                  DateTime          @updatedAt
}

model Household {
  id                String            @id @default(cuid())
  name              String
  paidAt            DateTime?
  deletedAt         DateTime?
  members           HouseholdMember[]
  invites           HouseholdInvite[]
  calendarEvents    CalendarEvent[]
  todoLists         TodoList[]
  shoppingLists     ShoppingList[]
  notes             Note[]
  expenseCategories ExpenseCategory[]
  choreCategories   ChoreCategory[]
  expenses          Expense[]
  chores            Chore[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

model HouseholdMember {
  id              String        @id @default(cuid())
  role            HouseholdRole @default(MEMBER)
  name            String        @db.VarChar(120)
  color           String        @default("sage") @db.VarChar(24)
  emoji           String?       @db.VarChar(32)
  accountId       String?       @unique
  createdByUserId String?
  householdId     String
  createdAt       DateTime      @default(now())
  household       Household     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  account         User?         @relation("HouseholdMemberAccount", fields: [accountId], references: [id], onDelete: SetNull)
  createdBy       User?         @relation("HouseholdMemberCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  linkedInvites   HouseholdInvite[] @relation("HouseholdInviteLinkedMember")

  expenses  Expense[]
  chores    Chore[]
  todoItems TodoItem[]

  @@index([householdId])
  @@index([createdByUserId])
}

model Chore {
  id                        String            @id @default(cuid())
  name                      String            @db.VarChar(200)
  assignmentType            ChoreAssignmentType @default(FIXED)
  recurrenceType            ChoreRecurrenceType @default(CUSTOM)
  startsAt                  DateTime
  intervalValue             Int
  intervalUnit              ChoreIntervalUnit
  weeklyDays                Int[]             @default([])
  rotationMemberIds         String[]          @default([])
  rotationIndex             Int               @default(0)
  assignedHouseholdMemberId String?
  categoryId                String?
  householdId               String
  createdByUserId           String?
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt
  completions               ChoreCompletion[]
  assignedHouseholdMember   HouseholdMember?  @relation(fields: [assignedHouseholdMemberId], references: [id], onDelete: SetNull)
  category                  ChoreCategory?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  household                 Household         @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdBy                 User?             @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([householdId])
  @@index([assignedHouseholdMemberId])
  @@index([categoryId])
  @@index([createdByUserId])
}

model ChoreCategory {
  id              String     @id @default(cuid())
  name            String     @db.VarChar(60)
  householdId     String
  createdByUserId String?
  createdAt       DateTime   @default(now())
  chores          Chore[]
  household       Household  @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdBy       User?      @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@unique([householdId, name])
  @@index([householdId])
  @@index([createdByUserId])
}

model ChoreCompletion {
  id                String   @id @default(cuid())
  choreId           String
  completedAt       DateTime @default(now())
  completedByUserId String?
  chore             Chore    @relation(fields: [choreId], references: [id], onDelete: Cascade)
  completedBy       User?    @relation(fields: [completedByUserId], references: [id], onDelete: SetNull)

  @@index([choreId, completedAt])
  @@index([completedByUserId])
}

model CalendarEvent {
  id                 String                @id @default(cuid())
  dateKey            String                @db.VarChar(10)
  name               String                @db.VarChar(200)
  category           CalendarEventCategory
  allDay             Boolean               @default(true)
  time               String?               @db.VarChar(5)
  householdMemberIds String[]              @default([])
  householdId        String?
  createdByUserId    String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  household          Household?            @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdBy          User?                 @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([dateKey])
  @@index([householdId, dateKey])
  @@index([createdByUserId, dateKey])
}

model Note {
  id              String     @id @default(cuid())
  title           String     @db.VarChar(200)
  body            String     @db.Text
  householdId     String?
  createdByUserId String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  household       Household? @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdBy       User?      @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([householdId])
  @@index([createdByUserId])
}

model TodoList {
  id              String     @id @default(cuid())
  name            String     @db.VarChar(120)
  householdId     String?
  createdByUserId String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  items           TodoItem[]
  household       Household? @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdBy       User?      @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([householdId])
  @@index([createdByUserId])
}

model TodoItem {
  id                        String           @id @default(cuid())
  text                      String           @db.VarChar(500)
  done                      Boolean          @default(false)
  assignedHouseholdMemberId String?
  dueDate                   DateTime?
  todoListId                String
  createdAt                 DateTime         @default(now())
  updatedAt                 DateTime         @updatedAt
  assignedHouseholdMember   HouseholdMember? @relation(fields: [assignedHouseholdMemberId], references: [id], onDelete: SetNull)
  list                      TodoList         @relation(fields: [todoListId], references: [id], onDelete: Cascade)

  @@index([assignedHouseholdMemberId])
  @@index([dueDate])
  @@index([todoListId])
}

model ShoppingList {
  id              String         @id @default(cuid())
  name            String         @db.VarChar(120)
  householdId     String?
  createdByUserId String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  items           ShoppingItem[]
  household       Household?     @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdBy       User?          @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([householdId])
  @@index([createdByUserId])
}

model ShoppingItem {
  id             String       @id @default(cuid())
  text           String       @db.VarChar(500)
  done           Boolean      @default(false)
  shoppingListId String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  list           ShoppingList @relation(fields: [shoppingListId], references: [id], onDelete: Cascade)

  @@index([shoppingListId])
}

model ExpenseCategory {
  id              String     @id @default(cuid())
  name            String     @db.VarChar(60)
  color           String     @default("#6e9274") @db.VarChar(7)
  householdId     String?
  createdByUserId String?
  createdAt       DateTime   @default(now())
  expenses        Expense[]
  household       Household? @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdBy       User?      @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([householdId])
  @@index([createdByUserId])
}

model Expense {
  id                String           @id @default(cuid())
  name              String           @db.VarChar(200)
  amount            Decimal          @db.Decimal(12, 2)
  type              ExpenseType
  date              DateTime
  notes             String?          @db.VarChar(1000)
  memberName        String?          @db.VarChar(120)
  householdMemberId String?
  categoryId        String?
  householdId       String?
  createdByUserId   String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  householdMember   HouseholdMember? @relation(fields: [householdMemberId], references: [id], onDelete: SetNull)
  category          ExpenseCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  household         Household?       @relation(fields: [householdId], references: [id], onDelete: Cascade)
  createdBy         User?            @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([householdId])
  @@index([householdId, date])
  @@index([categoryId])
  @@index([createdByUserId])
}

model ContactMessage {
  id            String    @id @default(cuid())
  name          String?   @db.VarChar(120)
  email         String    @db.VarChar(320)
  message       String    @db.Text
  deliveryError String?   @db.Text
  sentAt        DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([email])
  @@index([createdAt])
}

model HouseholdInvite {
  id                String           @id @default(cuid())
  tokenHash         String           @unique
  email             String
  householdId       String
  invitedById       String
  householdMemberId String?
  status            InviteStatus     @default(PENDING)
  expiresAt         DateTime
  acceptedAt        DateTime?
  createdAt         DateTime         @default(now())
  household         Household        @relation(fields: [householdId], references: [id], onDelete: Cascade)
  invitedBy         User             @relation("InvitesSent", fields: [invitedById], references: [id], onDelete: Cascade)
  householdMember   HouseholdMember? @relation("HouseholdInviteLinkedMember", fields: [householdMemberId], references: [id], onDelete: SetNull)

  @@index([householdId])
  @@index([email])
  @@index([householdMemberId])
}
