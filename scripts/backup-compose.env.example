# Host-side variables used by docker compose for the backup container.
# Copy this file on the NAS host and keep it out of Git.

# Runtime env file consumed inside the container via `env_file`.
BACKUP_ENV_FILE=/etc/domek/backup-db.env

# Final NAS destination mounted into the container as /backup.
BACKUP_DESTINATION_DIR=/mnt/nas/domek-backups

# restic password file mounted read-only into the container.
RESTIC_PASSWORD_FILE_PATH=/etc/domek/restic-password
