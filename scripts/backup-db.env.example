# Domek database backup settings for the NAS host.
# Use either:
# - the direct Supabase Postgres URL on port 5432 when the runner has IPv6, or
# - the Supavisor session pooler URL on port 5432 when the runner is IPv4-only.
# Do not use transaction pooler URLs on port 6543.
BACKUP_DATABASE_URL="postgresql://postgres.PROJECT_REF:YOUR_DB_PASSWORD@aws-0-YOUR-REGION.pooler.supabase.com:5432/postgres"

# Destination directory inside the backup container.
# Mount your NAS path here, for example: -v /mnt/nas/domek-backups:/backup
BACKUP_DEST_DIR="/backup"
BACKUP_DESTINATION_SENTINEL="/backup/.domek-backup-target"

# restic repository location. This can live inside the mounted backup directory
# or point at any other restic backend you can reach from the container.
RESTIC_REPOSITORY="/backup/restic"
RESTIC_PASSWORD_FILE="/etc/domek/restic-password"
ALLOW_RESTIC_INIT="false"

# Optional overrides.
RECENT_KEEP="96"
DAILY_KEEP="35"
COMPRESSOR="zstd"
PGAPPNAME="domek-backup"
RESTIC_TAGS="domek,database,production"
