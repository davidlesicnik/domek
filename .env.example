# App
APP_URL="http://localhost:3000"
AUTH_SECRET="replace-with-a-long-random-secret"
# Optional extra dev hosts when APP_URL is unset in development
# AUTH_DEV_ALLOWED_HOSTS="localhost,127.0.0.1"

# Database
DATABASE_URL="postgresql://domek:domek@postgres:5432/domek?schema=public"
POSTGRES_DB="domek"
POSTGRES_USER="domek"
POSTGRES_PASSWORD="domek"

# Optional SMTP for invites and password reset email
# If omitted, invites fall back to copyable links and password resets require operator help.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Domek <noreply@example.com>"
SMTP_SECURE="false"

# E2E QA auth bootstrap
QA_TEST_EMAIL="qa@example.com"
QA_TEST_PASSWORD="replace-with-a-test-password"

# Web Push (optional) — generate keys with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_MAILTO="mailto:admin@example.com"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""

# Notification scheduler secret
NOTIFY_SECRET=""
NOTIFY_INTERVAL_SECONDS="86400"
