# Database
# Production: use Supabase pooler (port 6543, transaction mode) for DATABASE_URL
# and the direct connection (port 5432) for DIRECT_URL (migrations only)
#DATABASE_URL="postgresql://domek:domek@[host]:6543/postgres?pgbouncer=true&connection_limit=5"
#DIRECT_URL="postgresql://domek:[password]@[host]:5432/postgres?sslmode=require"
# Local dev
# DATABASE_URL="postgresql://domek:domek@localhost:5432/domek?schema=public"
CONTAINER_DATABASE_URL="postgresql://domek:domek@postgres:5432/domek?schema=public"
DIRECT_URL="postgresql://domek:[password]@[host]:5432/postgres?sslmode=require"
POSTGRES_DB="domek"
POSTGRES_USER="domek"
POSTGRES_PASSWORD="domek"
POSTGRES_PORT="5432"

# Supabase Auth
SUPABASE_URL=""
SUPABASE_ANON_KEY=""

# Public URL (required in production to build correct OAuth redirect URLs)
# Set to your deployed origin, e.g. https://domek-317010634946.europe-west1.run.app
# APP_URL=""

# Development-only access bypass (optional)
# Disabled by default and rejected when NODE_ENV=production.
# If you enable it locally, set both variables.
ENABLE_DEVELOPMENT_ACCESS_BYPASS="false"
DEVELOPMENT_ACCESS_CODE=""

# Paddle Billing
# Use sandbox values while testing. Keep the token, price, webhook secret, and API key
# in the same Paddle environment.
# - PADDLE_CLIENT_TOKEN: Developer tools -> Authentication -> Client-side tokens
# - PADDLE_PRICE_ID: Catalog -> Products -> open product -> copy recurring price ID (pri_...)
# - PADDLE_WEBHOOK_SECRET: Developer tools -> Notifications -> open destination -> endpoint secret key
# - PADDLE_API_KEY: Developer tools -> Authentication -> API keys
# Sandbox client tokens begin with test_ and live tokens begin with live_.
PADDLE_CLIENT_TOKEN=""
PADDLE_PRICE_ID=""
PADDLE_WEBHOOK_SECRET=""
PADDLE_API_KEY=""

# Analytics (optional; public browser values)
# NEXT_PUBLIC_UMAMI_WEBSITE_ID=""
# NEXT_PUBLIC_META_PIXEL_ID=""

# Email (Resend — https://resend.com)
# Use re_test_... keys in dev; defaults to onboarding@resend.dev sender
RESEND_API_KEY=""
FROM_EMAIL="Domek <noreply@domekapp.com>"

# Web Push (VAPID) — generate keys with: npx web-push generate-vapid-keys
# NEXT_PUBLIC_VAPID_PUBLIC_KEY is the same value as VAPID_PUBLIC_KEY but exposed to the browser
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_MAILTO="mailto:admin@domekapp.com"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""

# Cron secret — protects the /api/notify/send endpoint
NOTIFY_SECRET=""
